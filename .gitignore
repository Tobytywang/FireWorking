# ===== 环境与缓存 =====
.venv/
.pyenv/
__pycache__/
*.pyc
.tmp/

# ===== 项目本地数据(不纳入版本控制) =====
.workbuddy/

# ===== 运行数据 / 数据库(活动记录、测试库) =====
*.db

# ===== 临时探针 / 调试产物(以 _ 开头的临时文件) =====
_*.txt
_*.png
_*.log
# 探针写出的临时页面（_ov_probe_1.py 等会把注入脚本的副本写成 _*_tmp.html 再喂给 Chrome）
_*_tmp.html
# 手工留存的报告副本（派生产物，可由 report.py 重新生成）
_*_demo.html

# ===== 报告验证截图与生成产物(data/ 下) =====
keyboard-heat/data/**/*.png
keyboard-heat/data/*.png
keyboard-heat/data/heat-report*.html

# ===== 备份文件 =====
*.bak
*.v1bak

# ===== 生成的篝火素材(体积大、非源码) =====
generated-images/

# ===== PyInstaller 构建产物 =====
dist/
build/
*.spec
